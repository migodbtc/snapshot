{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AppAgentContract",
  "description": "Briefing input and debriefing output schema for the Snapshot Portfolio AppAgent (@app-agent) subagent",
  "type": "object",
  "definitions": {
    "BriefingPayload": {
      "type": "object",
      "required": ["objective", "route_scope"],
      "properties": {
        "objective": { "type": "string" },
        "route_scope": {
          "type": "string",
          "description": "Target route directory in app/ (e.g. app/v2/landing, app/v2/blog, app/actions)"
        },
        "component_targets": {
          "type": "array",
          "items": { "type": "string" }
        },
        "design_requirements": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "DebriefingPayload": {
      "type": "object",
      "required": ["status", "summary", "deliverables"],
      "properties": {
        "status": { "type": "string", "enum": ["COMPLETED", "BLOCKED", "FAILED"] },
        "summary": { "type": "string" },
        "deliverables": { "type": "array" },
        "notes_for_orchestrator": { "type": "string" }
      }
    }
  }
}
