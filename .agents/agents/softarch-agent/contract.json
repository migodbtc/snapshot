{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SoftArchContract",
  "description": "Briefing input and debriefing output schema for the Snapshot Portfolio SoftArch (@softarch-agent) subagent",
  "type": "object",
  "definitions": {
    "BriefingPayload": {
      "type": "object",
      "required": ["objective", "context_slices"],
      "properties": {
        "objective": { "type": "string" },
        "context_slices": {
          "type": "array",
          "items": { "type": "string" }
        },
        "constraints": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "DebriefingPayload": {
      "type": "object",
      "required": ["status", "summary", "deliverables"],
      "properties": {
        "status": { "type": "string", "enum": ["COMPLETED", "BLOCKED", "FAILED"] },
        "summary": { "type": "string" },
        "deliverables": { "type": "array" },
        "notes_for_orchestrator": { "type": "string" }
      }
    }
  }
}
